#The following was submitted as a job to the University of Birmingham BlueBEAR remote computing environment:

#!/bin/bash
#SBATCH --account=quickj-plasmodium-knowlesi-barcode
#SBATCH --qos=bbdefault
#SBATCH --cpus-per-task=8
#SBATCH --time=10:00:00

#Clear any previous modules, maintain regular software versions 
module purge; module load bluebear

#Change to project directory containing accession and SRR directories 
cd /rds/projects/q/quickj-plasmodium-knowlesi-barcode

#Load fastp into environment
module load bear-apps/2023a; module load fastp/0.24.0-GCC-12.3.0

#Create 'Filtered' variable of path for fastp output
Filtered='/rds/projects/q/quickj-plasmodium-knowlesi-barcode/SRRs_filtered'

#Run fastp on each pair ended read for every SRR
for file in Accessions/*; do
	while read -r srr; do
        	fastp \
 		-i "SRRs/${srr}_1.fastq" -I "SRRs/${srr}_2.fastq" \
  		-o "${Filtered}/${srr}_1_fp.fastq" \
  		-O "${Filtered}/${srr}_2_fp.fastq" \
  		--cut_right \
  		--cut_right_mean_quality 25 \
  		-c 
    done < "$file"
done
