#The following was submitted as a job to the University of Birmingham BlueBEAR remote computing environment:

#!/bin/bash
#SBATCH --account=quickj-plasmodium-knowlesi-barcode
#SBATCH --qos=bbdefault
#SBATCH --cpus-per-task=8
#SBATCH --time=10:00:00

#Clear any previous modules, maintain regular software versions 
module purge; module load bluebear

#Change to project directory containing Accession and SRR directories 
cd /rds/projects/q/quickj-plasmodium-knowlesi-barcode

#Load fastqc into environment
module load bear-apps/2023a; module load FastQC/0.11.9-Java-11 

#Create 'Reads' variable of path for fastqc output
Reads='/rds/projects/q/quickj-plasmodium-knowlesi-barcode/Reads'

#Run fastqc on each pair ended read for every SRR
for file in Accessions/*; do
	while read -r srr; do
        	fastqc -t 8 "SRRs/${srr}_1.fastq" -o ${Reads}/
			fastqc -t 8 "SRRs/${srr}_2.fastq" -o ${Reads}/
    done < "$file"
done
